
{
  "info": {
    "_postman_id": "4f8a1a0c-9f1c-4d10-aaaa-000000000123",
    "name": "LC-NC Facade — Local Tests",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "End-to-end tests for the NestJS façade: health, idempotency, rate limit, circuit breaker, metrics, and webhook HMAC."
  },
  "item": [
    {
      "name": "00 Health",
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{baseUrl}}/v1/health", "host": ["{{baseUrl}}"], "path": ["v1", "health"] }
      }
    },
    {
      "name": "10 Send (first call) — sandbox",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Idempotency-Key", "value": "{{idemKey}}" },
          { "key": "X-Tenant-Id", "value": "{{tenantId}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"to\": [{\"email\": \"user@example.com\"}],\n  \"subject\": \"Hello\",\n  \"text\": \"Hi from Postman\"\n}"
        },
        "url": { "raw": "{{baseUrl}}/v1/adapter/sendgrid/send", "host": ["{{baseUrl}}"], "path": ["v1","adapter","sendgrid","send"] }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('status is 200', function () { pm.response.to.have.status(200); });",
              "pm.test('not cached', function () { pm.expect(pm.response.json().cached).to.eql(false); });"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "11 Send (replay same key) — returns cached: true",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Idempotency-Key", "value": "{{idemKey}}" },
          { "key": "X-Tenant-Id", "value": "{{tenantId}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"to\": [{\"email\": \"user@example.com\"}],\n  \"subject\": \"Hello\",\n  \"text\": \"Hi from Postman\"\n}"
        },
        "url": { "raw": "{{baseUrl}}/v1/adapter/sendgrid/send", "host": ["{{baseUrl}}"], "path": ["v1","adapter","sendgrid","send"] }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('status is 200', function () { pm.response.to.have.status(200); });",
              "pm.test('cached', function () { pm.expect(pm.response.json().cached).to.eql(true); });"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "12 Send (same key, different body) — 409 Conflict",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Idempotency-Key", "value": "{{idemKey}}" },
          { "key": "X-Tenant-Id", "value": "{{tenantId}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"to\": [{\"email\": \"user@example.com\"}],\n  \"subject\": \"DIFFERENT\",\n  \"text\": \"Hi from Postman\"\n}"
        },
        "url": { "raw": "{{baseUrl}}/v1/adapter/sendgrid/send", "host": ["{{baseUrl}}"], "path": ["v1","adapter","sendgrid","send"] }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('status is 409', function () { pm.response.to.have.status(409); });",
              "pm.test('conflict message', function () { pm.expect(pm.response.json().error.type).to.exist; });"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "20 Fake adapter — fail 1",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Idempotency-Key", "value": "cb-1" },
          { "key": "X-Tenant-Id", "value": "{{tenantId}}" }
        ],
        "body": { "mode": "raw", "raw": "{}" },
        "url": { "raw": "{{baseUrl}}/v1/adapter/fake/fail", "host": ["{{baseUrl}}"], "path": ["v1","adapter","fake","fail"] }
      }
    },
    {
      "name": "21 Fake adapter — fail 2",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Idempotency-Key", "value": "cb-2" },
          { "key": "X-Tenant-Id", "value": "{{tenantId}}" }
        ],
        "body": { "mode": "raw", "raw": "{}" },
        "url": { "raw": "{{baseUrl}}/v1/adapter/fake/fail", "host": ["{{baseUrl}}"], "path": ["v1","adapter","fake","fail"] }
      }
    },
    {
      "name": "22 Fake adapter — fail 3 (trips circuit)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Idempotency-Key", "value": "cb-3" },
          { "key": "X-Tenant-Id", "value": "{{tenantId}}" }
        ],
        "body": { "mode": "raw", "raw": "{}" },
        "url": { "raw": "{{baseUrl}}/v1/adapter/fake/fail", "host": ["{{baseUrl}}"], "path": ["v1","adapter","fake","fail"] }
      }
    },
    {
      "name": "23 Fake adapter — after CB (expect 503 for a short window)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Idempotency-Key", "value": "cb-4" },
          { "key": "X-Tenant-Id", "value": "{{tenantId}}" }
        ],
        "body": { "mode": "raw", "raw": "{}" },
        "url": { "raw": "{{baseUrl}}/v1/adapter/fake/fail", "host": ["{{baseUrl}}"], "path": ["v1","adapter","fake","fail"] }
      },
      "event": [
        {
          "listen": "test",
          "script": { "exec": ["pm.test('status is 503',()=>pm.response.to.have.status(503));"], "type": "text/javascript" }
        }
      ]
    },
    {
      "name": "30 Metrics (JSON)",
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{baseUrl}}/v1/metrics", "host": ["{{baseUrl}}"], "path": ["v1","metrics"] }
      }
    },
    {
      "name": "31 Metrics (Prometheus text)",
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{baseUrl}}/v1/metrics/prom", "host": ["{{baseUrl}}"], "path": ["v1","metrics","prom"] }
      }
    },
    {
      "name": "40 Webhook — valid signature",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "const body = pm.request.body && pm.request.body.raw ? pm.request.body.raw : '';",
              "const secret = pm.environment.get('webhookSecret') || '';",
              "const sig = CryptoJS.HmacSHA256(body, secret).toString(CryptoJS.enc.Hex);",
              "pm.environment.set('webhookSig', sig);"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "x-signature", "value": "{{webhookSig}}" }
        ],
        "body": { "mode": "raw", "raw": "{\n  \"type\": \"test\",\n  \"data\": {\"value\": 1}\n}" },
        "url": { "raw": "{{baseUrl}}/v1/webhooks/echo", "host": ["{{baseUrl}}"], "path": ["v1","webhooks","echo"] }
      },
      "response": []
    },
    {
      "name": "41 Webhook — invalid signature (expect 401)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "x-signature", "value": "deadbeef" }
        ],
        "body": { "mode": "raw", "raw": "{\n  \"type\": \"test\",\n  \"data\": {\"value\": 1}\n}" },
        "url": { "raw": "{{baseUrl}}/v1/webhooks/echo", "host": ["{{baseUrl}}"], "path": ["v1","webhooks","echo"] }
      }
    }
  ]
}
